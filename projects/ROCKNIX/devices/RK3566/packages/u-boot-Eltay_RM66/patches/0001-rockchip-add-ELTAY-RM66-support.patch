diff --git a/arch/arm/dts/rk3566-eltay-rm66-u-boot.dtsi b/arch/arm/dts/rk3566-eltay-rm66-u-boot.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm/dts/rk3566-eltay-rm66-u-boot.dtsi
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "rk356x-u-boot.dtsi"
+
+/ {
+	chosen {
+		u-boot,spl-boot-order = "same-as-spl", &sdmmc0, &sdhci;
+	};
+};
+
+&sfc {
+	u-boot,spl-sfc-no-dma;
+
+	flash@0 {
+		bootph-pre-ram;
+		bootph-some-ram;
+	};
+};
diff --git a/dts/upstream/src/arm64/rockchip/rk3566-eltay-rm66.dts b/dts/upstream/src/arm64/rockchip/rk3566-eltay-rm66.dts
new file mode 100644
--- /dev/null
+++ b/dts/upstream/src/arm64/rockchip/rk3566-eltay-rm66.dts
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+/*
+ * Minimal U-Boot control DT for the ELTAY RM66 module.
+ * Linux loads a separately selected carrier DTB from /boot/dtb/rockchip.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "rk3566.dtsi"
+
+/ {
+	model = "ELTAY RM66";
+	compatible = "elron,eltay-rm66", "rockchip,rk3566";
+
+	aliases {
+		mmc0 = &sdhci;
+		mmc1 = &sdmmc0;
+		spi4 = &sfc;
+	};
+
+	chosen {
+		stdout-path = "serial2:1500000n8";
+	};
+};
+
+&sdhci {
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	max-frequency = <200000000>;
+	mmc-hs200-1_8v;
+	non-removable;
+	pinctrl-names = "default";
+	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd &emmc_datastrobe>;
+	status = "okay";
+};
+
+&sdmmc0 {
+	bus-width = <4>;
+	cap-sd-highspeed;
+	disable-wp;
+	pinctrl-names = "default";
+	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
+	status = "okay";
+};
+
+&sfc {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <100000000>;
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <1>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "spl";
+				reg = <0x00000000 0x00060000>;
+				read-only;
+			};
+
+			partition@60000 {
+				label = "uboot";
+				reg = <0x00060000 0x001a0000>;
+				read-only;
+			};
+
+			partition@200000 {
+				label = "env";
+				reg = <0x00200000 0x00020000>;
+			};
+
+			partition@220000 {
+				label = "data";
+				reg = <0x00220000 0x00de0000>;
+			};
+		};
+	};
+};
+
+&uart2 {
+	status = "okay";
+};
